FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build

WORKDIR /app

# Copy project files
COPY *.csproj ./
COPY *.sln ./

# Restore dependencies
RUN dotnet restore

# Copy source code
COPY . .

# Build the project
RUN dotnet build -c Debug -o /app/build

# Install Azure Functions Core Tools
RUN wget -q https://packages.microsoft.com/config/ubuntu/22.04/packages-microsoft-prod.deb -O packages-microsoft-prod.deb
RUN dpkg -i packages-microsoft-prod.deb
RUN apt-get update && apt-get install -y azure-functions-core-tools-4

# Expose port
EXPOSE 80

# Start the Functions runtime
CMD ["func", "start", "--host", "0.0.0.0", "--port", "80", "--cors", "*"]

