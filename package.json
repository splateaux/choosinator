{
  "name": "choosinator",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "remix build",
    "dev": "remix dev --manual -c 'arc sandbox -e testing'",
    "dev:auto": "PORT=${PORT:-3333} arc sandbox",
    "dev:setup": "node scripts/dev-setup.js",
    "dev:with-user": "npm run dev:auto & node scripts/wait-for-server.js",
    "format": "prettier --write .",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "cross-env NODE_ENV=production arc sandbox",
    "test": "vitest",
    "test:playwright": "playwright test",
    "test:playwright:headed": "playwright test --headed",
    "test:playwright:debug": "playwright test --debug",
    "test:e2e": "start-server-and-test 'PORT=3334 npm run dev:auto' http://localhost:3334 'playwright test'",
    "test:e2e:debug": "start-server-and-test 'PORT=3334 npm run dev:auto' http://localhost:3334 'playwright test --headed --ui'",
    "validate": "run-p 'test -- --run' lint typecheck test:e2e",
    "prepare": "husky",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@architect/architect": "^10.16.3",
    "@architect/functions": "^7.0.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "@remix-run/architect": "2.17.0",
    "@remix-run/css-bundle": "2.17.0",
    "@remix-run/node": "2.17.0",
    "@remix-run/react": "2.17.0",
    "bcryptjs": "^3.0.2",
    "isbot": "^5.1.29",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tiny-invariant": "^1.3.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@playwright/test": "^1.54.2",
    "@remix-run/dev": "2.17.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@types/architect__functions": "^3.13.11",
    "@types/eslint": "^8.56.12",
    "@types/node": "^18.19.121",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^0.34.6",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "esbuild": "^0.19.12",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^27.9.0",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-markdown": "^3.0.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-testing-library": "^6.5.0",
    "happy-dom": "^12.10.3",
    "husky": "^9.1.7",
    "mock-aws-s3": "^4.0.2",
    "msw": "^1.3.5",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.54.2",
    "postcss": "^8.5.6",
    "prettier": "^3.0.3",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "start-server-and-test": "^2.0.12",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.1.6",
    "vite": "^5.4.19",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^0.34.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
